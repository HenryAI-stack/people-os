<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF only brings in UIAutomationClient/UIAutomationTypes (System.Windows.Automation); the UI is WinForms. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CaptionGrabber</AssemblyName>
    <RootNamespace>CaptionGrabber</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>Caption Grabber</Product>
    <Company>Max Bielecki</Company>
    <Description>Captures Microsoft Teams live captions on screen and copies them as a transcript.</Description>
    <Copyright>© 2026 Max Bielecki</Copyright>

    <!-- Publish settings (self-contained single exe) are passed by the build workflow, so tests can reference this project. -->
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CaptionGrabber.Tests" />
  </ItemGroup>

</Project>
