# Copy to .env for local development — never commit the real .env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=people-os-data
VITE_GITHUB_TOKEN=
VITE_GITHUB_BRANCH=main

# 32+ character secret used for AES-256 encryption of all records.
# This must NEVER change once you have real data, or it becomes unreadable.
VITE_ENCRYPTION_SECRET=

# The single Google account allowed to log in. Any other account is signed
# straight back out. Required — leaving this blank locks everyone out.
VITE_ALLOWED_EMAIL=

# Optional: lets the "Send this month's email" button in Accomplishments
# trigger the accomplishments-email workflow on demand. Fine-grained PAT
# scoped to ONLY this repo, permission "Actions: Read and write" — nothing
# else. Without it, the button just shows a clear error; the scheduled
# Thursday send still works regardless.
VITE_GH_ACTIONS_TOKEN=
