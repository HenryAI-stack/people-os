# Copy to .env for local development — never commit the real .env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=people-os-data
VITE_GITHUB_TOKEN=
VITE_GITHUB_BRANCH=main

# 32+ character secret used for AES-256 encryption of all records.
# This must NEVER change once you have real data, or it becomes unreadable.
VITE_ENCRYPTION_SECRET=

# The single Google account allowed to log in. Any other account is signed
# straight back out. Required — leaving this blank locks everyone out.
VITE_ALLOWED_EMAIL=

# Optional: powers the AI interview tags, takeaways, follow-up-topic
# suggestions, and executive summaries (via OpenRouter). Get a key at
# https://openrouter.ai/keys and put at least $10 of credit on the account
# (the free tier is rate-limited to ~50 requests/day). Without this key,
# those buttons just show an error; everything else works.
VITE_OPENROUTER_API_KEY=

# Optional: override the OpenRouter model. Defaults to google/gemini-2.5-flash
# (see src/lib/ai.js). Set this if that slug gets retired ("No endpoints
# found") or you want a different model — current list at
# https://openrouter.ai/models.
VITE_OPENROUTER_MODEL=

# Optional: two-way sync of follow-ups with Microsoft To Do. Application (client)
# ID of an Entra ID app registration (platform: Single-page application,
# delegated permission: Tasks.ReadWrite) — see INSTALLATION.md. Once set, sign
# in once from the app's Settings page; PeopleOS silently renews its own
# access token from then on via MSAL.js, no manual token refresh needed.
# Without it, the "Sync to Outlook" action just shows an error.
VITE_MS_GRAPH_CLIENT_ID=

# Optional: tenant restriction for the app registration above. Leave unset
# (defaults to "common") unless your Entra ID app registration is
# single-tenant, in which case set it to that tenant's ID.
VITE_MS_GRAPH_TENANT_ID=

# Optional: lets the "Send this month's email" button in Accomplishments
# trigger the accomplishments-email workflow on demand. Fine-grained PAT
# scoped to ONLY this repo, permission "Actions: Read and write" — nothing
# else. Without it, the button just shows a clear error; the scheduled
# Thursday send still works regardless.
VITE_GH_ACTIONS_TOKEN=
